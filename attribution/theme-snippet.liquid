{%- comment -%}
  Coddiwomple attribution capture — cw-attribution
  Source of truth: coddiwomple-data-architecture.md §3.

  PASTE TARGET: layout/theme.liquid, immediately before </head>.
  Either paste this file's <script> block directly, or save this file as
  snippets/cw-attribution.liquid and add {%- render 'cw-attribution' -%} there.

  First-touch wins, 30-day window. Underscore-prefixed cart attributes are
  hidden from the customer at checkout but still land in the order payload,
  readable as order.note_attributes.

  NON-RETROACTIVE. Click IDs not captured on the day are gone forever.
{%- endcomment -%}
<script>
(function () {
  var KEY = 'cw_attr', TTL = 30 * 864e5;
  var p = new URLSearchParams(location.search);
  var stored = null;
  try { stored = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) {}

  var incoming = null;
  if (p.get('fbclid') || p.get('ttclid') || p.get('utm_source')) {
    incoming = {
      click_id: p.get('fbclid') || p.get('ttclid') || null,
      click_platform: p.get('fbclid') ? 'meta' : (p.get('ttclid') ? 'tiktok' : null),
      utm_source: p.get('utm_source'), utm_medium: p.get('utm_medium'),
      utm_campaign: p.get('utm_campaign'), utm_content: p.get('utm_content'),
      utm_term: p.get('utm_term'),
      landing: location.pathname, ts: Date.now()
    };
  }

  // First-touch wins unless the stored one has expired.
  var attr = (stored && Date.now() - stored.ts < TTL) ? stored : incoming;
  if (!attr) return;
  try { localStorage.setItem(KEY, JSON.stringify(attr)); } catch (e) {}

  // Push into cart attributes so it survives into the order.
  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ attributes: {
      _cw_click_id: attr.click_id || '',
      _cw_platform: attr.click_platform || '',
      _cw_campaign: attr.utm_campaign || '',
      _cw_content: attr.utm_content || '',
      _cw_landing: attr.landing || ''
    }})
  }).catch(function () {});
})();
</script>
